---
import { FileDown } from "lucide-react";
import SectionHeader from "./SectionHeader.astro";
import { aboutText, availability, profile } from "../data/links";
import { education } from "../data/education";
---

<section id="about" class="scroll-mt-24">
  <div class="section-shell">
    <SectionHeader title="About" />
    <p class="max-w-[720px] text-lg leading-[1.7] text-text-secondary">
      {aboutText}
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <span class="telltale telltale-amber">{availability}</span>
      <a
        href={profile.resume}
        target="_blank"
        rel="noopener noreferrer"
        class="telltale telltale-amber gap-2"
      >
        <FileDown size={16} strokeWidth={2.25} />
        Resume
      </a>
    </div>
    <div class="mt-14 max-w-[720px]">
      <h3 class="font-dash text-xs font-bold uppercase tracking-[0.12em] text-lcd-amber-bright">
        Education
      </h3>
      <ul class="mt-5 space-y-5">
        {
          education.map((item) => (
            <li class="grid grid-cols-[auto_1fr] items-baseline gap-x-5 gap-y-1">
              <p class="font-mono text-[13px] tabular-nums text-text-muted">{item.dates}</p>
              <div>
                <p class="font-display text-base font-medium text-text-primary">{item.school}</p>
                <p class="mt-0.5 text-sm text-text-secondary">{item.credential}</p>
                {item.detail && <p class="mt-1 text-sm text-text-muted">{item.detail}</p>}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
