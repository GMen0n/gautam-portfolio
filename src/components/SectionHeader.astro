---
interface Props {
  index: string;
  title: string;
}

const { index, title } = Astro.props;
---

<div class="mb-10 flex items-center gap-3">
  <span class="font-mono text-sm font-medium tracking-wide text-text-muted">[{index}]</span>
  <span class="font-mono text-sm text-text-muted">/</span>
  <h2 class="font-display text-sm font-medium uppercase tracking-[0.14em] text-text-primary">
    {title}
  </h2>
  <span class="h-px flex-1 bg-bg-surface"></span>
</div>
