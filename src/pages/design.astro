---
import { ArrowLeft } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import DesignGallery from "../components/DesignGallery";
import { designStacks } from "../data/design";
---

<BaseLayout
  title="Design Work — Gautam Menon"
  description="Posters, branding, and design leadership from Maaya, UniCon, GDSC, and The ECC Odyssey."
>
  <Navbar client:load />
  <main class="pt-24">
    <div class="section-shell">
      <a href="/#skills" class="telltale telltale-amber gap-2">
        <ArrowLeft size={16} strokeWidth={1.5} />
        Back
      </a>
      <div class="section-heading mt-10">
        <span class="section-led" aria-hidden="true"></span>
        <h1>Design Work</h1>
      </div>
      <p class="max-w-[640px] text-base leading-relaxed text-text-secondary">
        Stacks of campaign work. Hover pauses the shuffle — click to open the full gallery.
      </p>
      <DesignGallery client:load stacks={designStacks} />
    </div>
  </main>
  <Footer />
</BaseLayout>
