---
import { ArrowLeft, ArrowUpRight } from "lucide-react";
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar";
import Footer from "../components/Footer.astro";
import { tbp } from "../data/tbp";
---

<BaseLayout title={`${tbp.name} — Gautam Menon`} description={tbp.description}>
  <Navbar client:load />
  <main class="pt-24">
    <div class="section-shell">
      <a href="/" class="link-slide inline-flex items-center gap-2 text-sm text-text-secondary">
        <ArrowLeft size={16} stroke-width={1.5} />
        Back to Portfolio
      </a>
      <p class="mt-12 font-mono text-sm text-text-muted">{tbp.role}</p>
      <h1
        class="mt-4 font-display text-4xl font-bold uppercase leading-[1.1] tracking-[0.12em] text-text-primary md:text-6xl"
      >
        The Buyers
        <br />
        Perspective
      </h1>
      <p class="mt-6 max-w-[640px] text-lg leading-relaxed text-text-secondary">
        {tbp.description}
      </p>

      <div
        class="mt-12 aspect-video w-full overflow-hidden rounded-2xl border border-bg-surface bg-bg-elevated"
      >
        {
          tbp.youtubeId ? (
            <iframe
              class="h-full w-full"
              src={`https://www.youtube.com/embed/Fvcnb_YY70w?si=jRnn5ynMI9JWEPm-`}
              title={`${tbp.name} featured video`}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          ) : (
            <div class="flex h-full items-center justify-center px-6 text-center text-text-muted">
              Featured video will live here. Add a YouTube ID in src/data/tbp.ts.
            </div>
          )
        }
      </div>

      <div class="mt-12 max-w-[640px]">
        <h2 class="font-display text-xs font-medium uppercase tracking-[0.08em] text-text-muted">
          What I Do
        </h2>
        <p class="mt-4 text-lg text-text-secondary">{tbp.roles.join(" · ")}</p>
      </div>

      <div class="mt-8 flex flex-wrap gap-4">
        {
          tbp.youtubeUrl && (
            <a
              href={tbp.youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-sm text-accent-teal"
            >
              YouTube
              <ArrowUpRight size={14} stroke-width={1.5} />
            </a>
          )
        }
        {
          tbp.instagramUrl && (
            <a
              href={tbp.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 text-sm text-accent-teal"
            >
              Instagram
              <ArrowUpRight size={14} stroke-width={1.5} />
            </a>
          )
        }
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
